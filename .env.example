# ────────────────────────────────────────────────────────────────
# Talmicahel — Environment Variables
# Copy this file to .env and fill in your values
# ────────────────────────────────────────────────────────────────

# ── MongoDB ─────────────────────────────────────────────────────
# Local dev: mongodb://localhost:27017
# Docker:    automatically overridden to mongodb://mongo:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=talmicahel

# ── Auth ─────────────────────────────────────────────────────────
# CHANGE THIS in production — must be 32+ chars
SECRET_KEY=change_me_in_production_32chars_min
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI Keys (all optional — features degrade gracefully if empty) ─
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
CLAUDE_API_KEY=

# ── App ──────────────────────────────────────────────────────────
DEBUG=false
