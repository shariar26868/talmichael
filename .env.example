# ────────────────────────────────────────────────────────────────
# Talmicahel — Environment Variables
# Copy this file to .env and fill in your values
# ────────────────────────────────────────────────────────────────

# ── MongoDB ─────────────────────────────────────────────────────
# Local dev: mongodb://localhost:27017
# Docker:    automatically overridden to mongodb://mongo:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=talmicahel

# ── Auth ─────────────────────────────────────────────────────────
# CHANGE THIS in production — must be 32+ chars
SECRET_KEY=change_me_in_production_32chars_min
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI Keys (all optional — features degrade gracefully if empty) ─
OPENAI_API_KEY=
GEMINI_API_KEY=



# ── External Fact-Check APIs (optional) ──────────────────────────
# Google Fact Check Tools API — free, requires Google Cloud API key
# Get one at: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACTCHECK_API_KEY=

# ── App ──────────────────────────────────────────────────────────
DEBUG=false

# Optional Redis URL for caching (redis://[:password]@host:port/0)
REDIS_URL=

# Scheduler settings
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Jerusalem
